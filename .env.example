VITE_KIMAI_API_URL=https://your-kimai-instance.com/api

# --- Work Schedule Configuration ---
# Default: 08:00 - 17:00 (8 hours workday)
VITE_WORK_START_TIME=08:00
VITE_WORK_END_TIME=17:00

# Lunch break (excluded from work duration)
VITE_LUNCH_START=12:00
VITE_LUNCH_END=13:00

# Chunk size in hours (timesheet records are split into chunks)
VITE_CHUNK_HOURS=2
